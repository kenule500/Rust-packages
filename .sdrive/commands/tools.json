    },
    {
      "name": "trae",
      "label": "Trae",
      "docs": "https://docs.trae.ai/ide/rules",
      "verified": false,
      "adapterPaths": [{ "path": ".trae/rules/project_rules.md", "format": "md", "kind": "rules" }]
    },
    {
      "name": "openhands",
      "label": "OpenHands",
      "docs": "https://docs.all-hands.dev/usage/prompting/microagents-repo",
      "verified": false,
      "adapterPaths": [{ "path": ".openhands/microagents/sdrive.md", "format": "md", "kind": "rules" }]
    },
    {
