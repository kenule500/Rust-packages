{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature Specification",
  "type": "object",
  "properties": {
    "feature": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Machine-friendly feature name (kebab-case)"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "description": "Human-readable feature title"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "overview": {
      "type": "object",
      "properties": {
        "problemStatement": {
          "type": "string",
          "minLength": 10
        },
        "proposedSolution": {
          "type": "string",
          "minLength": 10
        },
        "targetAudience": {
          "type": "string",
          "minLength": 3
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "outOfScope": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["problemStatement", "proposedSolution", "targetAudience"]
    },
    "userStories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^US-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "role": { "type": "string" },
          "want": { "type": "string" },
          "benefit": { "type": "string" },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^AC-[0-9]{3}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 10
                }
              },
              "required": ["id", "text"]
            }
          }
        },
        "required": ["id", "title", "role", "want", "benefit", "acceptanceCriteria"]
      }
    },
    "functionalRequirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FR-[0-9]{3}$"
          },
          "text": {
            "type": "string",
            "minLength": 10
          },
          "linkedAcceptanceCriteria": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{3}$"
            }
          }
        },
        "required": ["id", "text"]
      }
    },
    "nonFunctionalRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^NFR-[0-9]{3}$"
          },
          "text": {
            "type": "string",
            "minLength": 10
          },
          "linkedAcceptanceCriteria": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{3}$"
            }
          }
        },
        "required": ["id", "text"]
      }
    },
    "edgeCases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EC-[0-9]{3}$"
          },
          "description": { "type": "string" },
          "expectedBehavior": { "type": "string" }
        },
        "required": ["id", "description", "expectedBehavior"]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": {
            "enum": ["library", "service", "internal", "external"]
          },
          "notes": { "type": "string" }
        },
        "required": ["name", "type"]
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RISK-[0-9]{3}$"
          },
          "description": { "type": "string" },
          "mitigation": { "type": "string" }
        },
        "required": ["id", "description", "mitigation"]
      }
    }
  },
  "required": [
    "feature",
    "title",
    "version",
    "overview",
    "userStories",
    "functionalRequirements"
  ],
  "additionalProperties": false
}