{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpecDrive Review Record",
  "type": "object",
  "properties": {
    "feature": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "status": {
      "enum": ["PASS", "FAIL"]
    },
    "commit": {
      "type": ["string", "null"]
    },
    "base": {
      "type": ["string", "null"]
    },
    "branch": {
      "type": ["string", "null"]
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "status": {
            "enum": ["pass", "fail", "warn", "not_verified"]
          },
          "detail": { "type": "string" }
        },
        "required": ["id", "status", "detail"],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": ["high", "medium", "low", "info"]
          },
          "issue": { "type": "string", "minLength": 3 },
          "location": { "type": "string" },
          "fixRequired": { "type": "boolean" },
          "acIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^AC-[0-9]{3}$" }
          }
        },
        "required": ["severity", "issue", "location", "fixRequired"],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "testEvidence": { "type": "string" },
        "testReport": { "type": "string" },
        "verification": { "type": "string" },
        "audit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["pass", "fail", "not_applicable", "not_verified"]
        },
        "reason": { "type": "string" },
        "secrets": { "enum": ["clean", "found", "not_verified"] },
        "dependencies": { "enum": ["clean", "vulnerable", "not_verified"] },
        "baseline": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 3 },
              "status": {
                "enum": ["pass", "fail", "not_applicable", "not_verified"]
              },
              "detail": { "type": "string" }
            },
            "required": ["id", "status"],
            "additionalProperties": false
          }
        },
        "report": { "type": "string" }
      },
      "required": ["status"],
      "additionalProperties": false
    },
    "performance": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["pass", "fail", "not_applicable", "not_verified"]
        },
        "reason": { "type": "string" },
        "method": { "type": "string" },
        "nfr": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 2 },
              "target": { "type": "string" },
              "measured": { "type": "string" },
              "status": {
                "enum": ["pass", "fail", "not_verified"]
              }
            },
            "required": ["id", "status"],
            "additionalProperties": false
          }
        },
        "seo": { "enum": ["pass", "fail", "not_applicable", "not_verified"] },
        "report": { "type": "string" }
      },
      "required": ["status"],
      "additionalProperties": false
    },
    "remediation": {
      "type": "object",
      "properties": {
        "round": { "type": "integer", "minimum": 1 },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "finding": { "type": "string", "minLength": 3 },
              "severity": { "enum": ["high", "medium", "low", "info"] },
              "fixWith": { "type": "string", "minLength": 3 },
              "task": { "type": "string" },
              "roundsFailed": { "type": "integer", "minimum": 1 },
              "assumption": { "type": "string" }
            },
            "required": ["finding", "fixWith"],
            "additionalProperties": false
          }
        }
      },
      "required": ["items"],
      "additionalProperties": false
    }
  },
  "required": [
    "feature",
    "version",
    "status",
    "commit",
    "reviewedBy",
    "reviewedAt",
    "coverage",
    "criteria",
    "findings"
  ],
  "additionalProperties": false
}
