{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Execution Tasks",
  "type": "object",
  "properties": {
    "feature": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "phaseId": {
            "type": "string",
            "pattern": "^P[0-9]+$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P[0-9]+$"
            }
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^T[0-9]+\\.[0-9]+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 5
                },
                "description": {
                  "type": "string"
                },
                "linkedRequirements": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(FR|NFR)-[0-9]{3}$"
                  },
                  "minItems": 1
                },
                "linkedAcceptanceCriteria": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^AC-[0-9]{3}$"
                  }
                },
                "completed": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "id",
                "title",
                "linkedRequirements",
                "completed"
              ]
            }
          }
        },
        "required": ["phaseId", "name", "tasks"]
      }
    }
  },
  "required": ["feature", "version", "phases"],
  "additionalProperties": false
}