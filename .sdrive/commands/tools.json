      "docs": "https://zed.dev/docs/ai/rules",
      "adapterPaths": [{ "path": ".rules", "format": "md", "kind": "rules", "extension": ".rules" }]
    },
    {
      "name": "aider",
      "label": "Aider",
      "docs": "https://aider.chat/docs/usage/conventions.html",
      "adapterPaths": [{ "path": "CONVENTIONS.md", "format": "md", "kind": "rules" }]
    },
    {
      "name": "kiro",
      "label": "Kiro (AWS)",
      "docs": "https://kiro.dev/docs/steering/",
      "adapterPaths": [{ "path": ".kiro/steering/sdrive.md", "format": "md", "kind": "rules" }]
