# SpecDrive gate artifacts are regenerated locally at the current HEAD.
# A committed gate artifact cannot also name its own commit hash, so
# test-evidence.json, verification.json, and review.json stay local.
.sdrive/governance/*/*/test-evidence.json
.sdrive/governance/*/*/verification.json
.sdrive/governance/*/*/review.json
.sdrive/reports/tests/raw/
.sdrive/audit-log.json
.sdrive/.backups/
.sdrive/handoff.json

# Cargo build output and local lockfile
target/
**/*.rs.bk
Cargo.lock
.DS_Store

# Local tool and command scratch logs (not project artifacts)
.perch/
.commandcode/
