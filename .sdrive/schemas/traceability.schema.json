{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Traceability Matrix",
  "type": "object",
  "properties": {
    "feature": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "requirementId": {
            "type": "string",
            "pattern": "^(FR|NFR)-[0-9]{3}$"
          },
          "acceptanceCriteriaIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{3}$"
            }
          },
          "planSection": {
            "type": "string"
          },
          "taskIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T[0-9]+\\.[0-9]+$"
            }
          },
          "testIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^TEST-[0-9]{3}$"
            }
          },
          "status": {
            "enum": ["not_started", "in_progress", "complete"]
          }
        },
        "required": [
          "requirementId",
          "acceptanceCriteriaIds",
          "taskIds",
          "status"
        ]
      }
    }
  },
  "required": ["feature", "version", "rows"],
  "additionalProperties": false
}