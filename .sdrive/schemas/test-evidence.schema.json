{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpecDrive Test Evidence",
  "type": "object",
  "properties": {
    "feature": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": ["string", "null"]
    },
    "exitCode": {
      "type": "integer"
    },
    "timedOut": {
      "type": "boolean"
    },
    "signal": {
      "type": ["string", "null"]
    },
    "commit": {
      "type": ["string", "null"]
    },
    "branch": {
      "type": ["string", "null"]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "outputHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "summary": {
      "type": "object",
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "required": ["passed", "failed", "skipped", "total"],
      "additionalProperties": false
    },
    "testIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^TEST-[0-9]{3}$" }
    },
    "acIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^AC-[0-9]{3}$" }
    },
    "outputTail": {
      "type": "string"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "feature",
    "version",
    "command",
    "exitCode",
    "timedOut",
    "startedAt",
    "finishedAt",
    "durationMs",
    "outputHash",
    "summary",
    "testIds",
    "acIds"
  ],
  "additionalProperties": false
}
