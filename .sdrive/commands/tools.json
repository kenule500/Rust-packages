{
  "version": "2.0.0",
  "tools": [
    {
      "name": "agents-md",
      "label": "Any tool that reads AGENTS.md",
      "docs": "https://agents.md/",
      "adapterPaths": [{ "path": "AGENTS.md", "format": "md", "kind": "rules" }]
    },
    {
      "name": "github-copilot",
      "label": "GitHub Copilot (repository instructions)",
      "mcpClient": "vscode",
      "docs": "https://docs.github.com/en/copilot/how-tos/configure-custom-instructions/add-repository-instructions",
      "adapterPaths": [{ "path": ".github/copilot-instructions.md", "format": "md", "kind": "rules" }]
    },
    {
      "name": "cline",
      "label": "Cline",
      "mcpClient": "cline",
      "docs": "https://docs.cline.bot/features/cline-rules",
      "adapterPaths": [{ "path": ".clinerules/sdrive.md", "format": "md", "kind": "rules" }]
    },
    {
      "name": "claude-code",
      "label": "Claude Code",
      "mcpClient": "claude-desktop",
      "docs": "https://code.claude.com/docs/en/slash-commands",
      "adapterPaths": [
        { "path": ".claude/commands/sdrive", "format": "md", "kind": "command-set", "naming": "nested" }
      ]
    },
    {
      "name": "cursor",
      "label": "Cursor",
      "mcpClient": "cursor",
      "docs": "https://cursor.com/docs/context/rules",
      "adapterPaths": [
        {
          "path": ".cursor/rules/sdrive.mdc",
          "format": "mdc",
          "kind": "rules",
          "frontmatter": {
            "description": "SpecDrive command router for this project",
            "alwaysApply": true
          }
        }
      ]
    },
    {
      "name": "vscode-native",
      "label": "VS Code / Copilot (path-scoped instructions)",
      "mcpClient": "vscode",
      "docs": "https://code.visualstudio.com/docs/copilot/customization/custom-instructions",
      "adapterPaths": [
        {
          "path": ".github/instructions/sdrive.instructions.md",
          "format": "md",
          "kind": "rules",
          "frontmatter": { "applyTo": "**" }
        }
      ]
    },
    {
      "name": "amazon-q",
      "label": "Amazon Q Developer",
      "docs": "https://docs.aws.amazon.com/amazonq/latest/qdeveloper-ug/context-project-rules.html",
      "adapterPaths": [{ "path": ".amazonq/rules/sdrive.md", "format": "md", "kind": "rules" }]
    },
    {
      "name": "gemini-cli",
      "label": "Gemini CLI",
      "mcpClient": "gemini-cli",
      "docs": "https://github.com/google-gemini/gemini-cli/blob/main/docs/cli/custom-commands.md",
      "adapterPaths": [
        { "path": "GEMINI.md", "format": "md", "kind": "rules" },
        { "path": ".gemini/commands/sdrive", "format": "toml", "kind": "command-set", "naming": "nested" }
      ]
    },
    {
      "name": "continue",
      "label": "Continue",
      "docs": "https://docs.continue.dev/customize/rules",
      "adapterPaths": [{ "path": ".continue/rules/sdrive.md", "format": "md", "kind": "rules" }]
    },
    {
      "name": "codex",
      "label": "OpenAI Codex",
      "docs": "https://agents.md/",
      "adapterPaths": [{ "path": "AGENTS.md", "format": "md", "kind": "rules" }]
    },
    {
      "name": "windsurf",
      "label": "Windsurf (Cascade)",
      "docs": "https://docs.windsurf.com/windsurf/cascade/memories",
      "adapterPaths": [
        {
          "path": ".windsurf/rules/sdrive.md",
          "format": "md",
          "kind": "rules",
          "frontmatter": { "trigger": "always_on" }
        }
      ]
    },
    {
      "name": "kilo-code",
      "label": "Kilo Code",
      "mcpClient": "vscode",
      "docs": "https://kilocode.ai/docs/features/custom-rules",
      "adapterPaths": [{ "path": ".kilocode/rules/sdrive.md", "format": "md", "kind": "rules" }]
    },
    {
      "name": "opencode",
      "label": "OpenCode",
      "docs": "https://opencode.ai/docs/commands/",
      "adapterPaths": [
        { "path": "AGENTS.md", "format": "md", "kind": "rules" },
        { "path": ".opencode/commands", "format": "md", "kind": "command-set", "naming": "prefixed" }
      ]
    },
    {
      "name": "qoder",
      "label": "Qoder",
      "docs": "https://docs.qoder.com/user-guide/rules",
      "verified": false,
      "adapterPaths": [{ "path": ".qoder/rules/sdrive.md", "format": "md", "kind": "rules" }]
    },
    {
      "name": "qwen-code",
      "label": "Qwen Code",
      "docs": "https://github.com/QwenLM/qwen-code",
      "adapterPaths": [{ "path": "QWEN.md", "format": "md", "kind": "rules" }]
    },
    {
      "name": "rovo-dev",
      "label": "Atlassian Rovo Dev",
      "docs": "https://agents.md/",
      "verified": false,
      "adapterPaths": [{ "path": "AGENTS.md", "format": "md", "kind": "rules" }]
    },
    {
      "name": "roo-code",
      "label": "Roo Code",
      "mcpClient": "roo",
      "docs": "https://docs.roocode.com/features/custom-instructions",
      "adapterPaths": [
        { "path": ".roo/rules/sdrive.md", "format": "md", "kind": "rules" },
        { "path": ".roo/commands", "format": "md", "kind": "command-set", "naming": "prefixed" }
      ]
    },
    {
      "name": "amp",
      "label": "Amp (Sourcegraph)",
      "docs": "https://ampcode.com/docs/customize/agents-md",
      "adapterPaths": [{ "path": "AGENTS.md", "format": "md", "kind": "rules" }]
    },
    {
      "name": "warp",
      "label": "Warp",
      "docs": "https://docs.warp.dev/agents/capabilities/rules/",
      "adapterPaths": [{ "path": "WARP.md", "format": "md", "kind": "rules" }]
